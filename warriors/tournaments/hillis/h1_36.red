;redcode-imt2
; Fixed syntax for pMARS compatibility: removed colons from labels, standardized spaces, and/or fixed EQU/label conflicts.
;assert 1
;name h1_36
;author Dave Hillis
;dbhillis@erols.com
;strat -        Created with a GA.
;                Ilmari's Mini-Tournament #2.
spl.i  #   -30, >21
mov.i  *   -12, {0
mov.i  >   -29, {    -2
djn.x  $    -2, $    -3
end   0
